STACK_IMAGE=picpeak-pixcake:3.134.1-zh.20-bridge.0.1.8
PICPEAK_BASE=picpeak-zh:3.134.1-zh.19
# 初始化时 false，创建 Public API Token 后改 true 并重建容器。
BRIDGE_ENABLED=false
# 禁止 latest / stable / main 等可变标签；发布后可进一步锁定 @sha256。
# 默认仅本机；部署 fnOS 时改为 NAS 的局域网 IPv4，不能填 0.0.0.0。
LAN_BIND_IP=127.0.0.1
PICPEAK_PORT=3000
# 首先只启动 picpeak，完成初始化后在设置/集成中创建 read + write 令牌。
PICPEAK_TOKEN=
BRIDGE_ADMIN_PASSWORD=replace-with-random-password-at-least-12-characters
POLL_SECONDS=30
STABLE_SECONDS=10
MAX_FINAL_BYTES=104857600
HISTORY_KEEP=3
# auto: 仅只读原始 inode 尝试 hardlink，再 reflink，再 copy；copy:强制隔离副本。
RAW_MATERIALIZE_MODE=auto

# PicPeak 与 Bridge 对 Camera 的挂载始终只读；Bridge 另行写入单个项目的 PixCakeDelivery 子目录。
NAS_CAMERA_ROOT=/vol1/1000/Home/Camera
# Camera 目录属主 UID；用于让 PicPeak 只读访问已有照片。
NAS_CAMERA_UID=1000
# Preserve the existing legacy delivery mount for any saved Bridge state.
NAS_DELIVERY_ROOT=/vol1/1000/Home/PixCakeDelivery
# The current PicPeak project (ID 5, Camera/26-10-04) gets its own write mount.
NAS_PROJECT_5_DELIVERY_ROOT=/vol1/1000/Home/Camera/26-10-04/PixCakeDelivery
# Each active PicPeak project gets a separate restricted writable bind.
PROJECT_DELIVERY_MOUNTS='{"4":{"container":"/delivery","host":"/vol1/1000/Home/PixCakeDelivery"},"5":{"container":"/delivery-5","host":"/vol1/1000/Home/Camera/26-10-04/PixCakeDelivery"}}'
# 设为 NAS 交付目录属主的 UID/GID；飞牛常见值为 1000，应按实际权限核对。
BRIDGE_UID=1000
BRIDGE_GID=1000
