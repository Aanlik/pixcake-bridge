# 禁止 latest / stable / main 等可变标签；发布后可进一步锁定 @sha256。
PICPEAK_IMAGE=picpeak-zh:3.134.1-zh.4
BRIDGE_IMAGE=pixcake-bridge:0.1.1
PICPEAK_DEFAULT_LANGUAGE=zh-CN
# 默认仅本机；部署 fnOS 时改为 NAS 的局域网 IPv4，不能填 0.0.0.0。
LAN_BIND_IP=127.0.0.1
PICPEAK_PORT=3000
BRIDGE_PORT=8080
PHOTO_PROJECT=/vol1/1000/摄影项目/示例项目
PROJECT_FOLDER=示例项目
# 首先只启动 picpeak，完成初始化后在设置/集成中创建 read + write 令牌。
PICPEAK_TOKEN=pp_live_replace_me
BRIDGE_ADMIN_PASSWORD=replace-with-random-password-at-least-12-characters
POLL_SECONDS=30
STABLE_SECONDS=10
MAX_FINAL_BYTES=104857600
HISTORY_KEEP=3
# auto: 仅只读原始 inode 尝试 hardlink，再 reflink，再 copy；copy:强制隔离副本。
RAW_MATERIALIZE_MODE=auto

