# Build PicPeak separately from its own checkout; combine fixed versions here.
ARG PICPEAK_BASE=picpeak-zh:3.134.1-zh.17
FROM python:3.12.14-alpine AS bridge-python
FROM ${PICPEAK_BASE}
ARG STACK_VERSION=3.134.1-zh.17-bridge.0.1.4
LABEL org.opencontainers.image.title="PicPeak 简体中文 + PixCake Bridge" \
      org.opencontainers.image.source="https://github.com/Aanlik/pixcake-bridge" \
      org.opencontainers.image.version=${STACK_VERSION}
COPY --from=bridge-python /usr/local /usr/local
RUN apk add --no-cache supervisor coreutils libffi bzip2 xz-libs zlib expat sqlite-libs readline ncurses-libs libuuid && /usr/local/bin/python3.12 -m venv /opt/bridge/venv
COPY requirements.lock /opt/bridge/requirements.lock
RUN /opt/bridge/venv/bin/pip install --no-cache-dir -r /opt/bridge/requirements.lock
COPY pyproject.toml /opt/bridge/pyproject.toml
COPY src /opt/bridge/src
RUN /opt/bridge/venv/bin/pip install --no-cache-dir --no-deps /opt/bridge
COPY docker/integrated /opt/integrated
RUN chmod +x /opt/integrated/*.sh && mkdir -p /bridge-data /config && chown 1001:1001 /bridge-data && printf '[]\n' > /config/projects.json
ENV PICPEAK_URL=http://127.0.0.1:3000 \
    PIXCAKE_BRIDGE_URL=http://127.0.0.1:8080 \
    DATABASE_URL=sqlite:////bridge-data/bridge.db \
    PROJECTS_FILE=/config/projects.json \
    BRIDGE_ENABLED=false \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
VOLUME ["/bridge-data"]
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=8s --start-period=120s --retries=3 CMD /opt/bridge/venv/bin/python /opt/integrated/health.py
ENTRYPOINT ["dumb-init", "--", "/opt/integrated/start.sh"]
CMD []
